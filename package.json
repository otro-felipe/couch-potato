{
  "name": "couch-potato",
  "version": "0.1.0",
  "private": true,
  "description": "Local Playwright-like automation for your existing Chrome tabs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "couch-potato": "dist/client/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run test:coverage && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "install:host": "node dist/scripts/install-native-host.js",
    "uninstall:host": "node dist/scripts/uninstall-native-host.js",
    "doctor": "node dist/client/cli.js doctor",
    "status": "node dist/client/cli.js status"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
