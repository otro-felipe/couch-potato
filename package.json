{
  "name": "couch-potato",
  "version": "0.1.0",
  "private": true,
  "description": "Local Playwright-like automation for your existing Chrome tabs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otro-felipe/couch-potato.git"
  },
  "homepage": "https://github.com/otro-felipe/couch-potato#readme",
  "bugs": {
    "url": "https://github.com/otro-felipe/couch-potato/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "couch-potato": "dist/client/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "install:host": "node dist/scripts/install-native-host.js",
    "uninstall:host": "node dist/scripts/uninstall-native-host.js",
    "doctor": "node dist/client/cli.js doctor",
    "status": "node dist/client/cli.js status"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.9",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
