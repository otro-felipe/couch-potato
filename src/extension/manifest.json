{
  "manifest_version": 3,
  "name": "Couch Potato Browser Bridge",
  "description": "Local-only automation bridge for tabs in your existing Chrome profile.",
  "version": "0.1.0",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
